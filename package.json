{
  "name": "appfigures-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Appfigures API (products, sales/revenue reports, reviews).",
  "type": "module",
  "bin": {
    "appfigures-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "appfigures",
    "app-store",
    "aso",
    "analytics",
    "claude"
  ],
  "author": "Songtive (@desunit) <https://x.com/desunit>",
  "license": "MIT",
  "homepage": "https://github.com/desunit/appfigures-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desunit/appfigures-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/desunit/appfigures-mcp/issues"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
